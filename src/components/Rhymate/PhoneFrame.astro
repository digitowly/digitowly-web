---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
}

const { src, alt, class: className, loading = "lazy" } = Astro.props;
---

<figure
  class:list={[
    "overflow-hidden rounded-[2.6rem] bg-ink p-2 shadow-[0_40px_80px_-30px_rgb(18_58_49/0.45)]",
    className,
  ]}
>
  <Image
    src={src}
    alt={alt}
    widths={[320, 480, 720]}
    sizes="(min-width: 1024px) 22rem, 70vw"
    loading={loading}
    class="block h-auto w-full rounded-[2.1rem]"
  />
</figure>
