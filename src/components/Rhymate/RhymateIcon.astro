---
interface Props {
  size?: number;
  class?: string;
}

const { size = 96, class: className } = Astro.props;
const id = `ri-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={className}
  role="img"
  aria-label="Rhymate app icon"
  width={size}
  height={size}
  viewBox="0 0 1024 1024"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="1" stop-color="#dbffeb"></stop>
    </linearGradient>
    <linearGradient id={`${id}-fg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1c463d"></stop>
      <stop offset="1" stop-color="#133b33"></stop>
    </linearGradient>
    <clipPath id={`${id}-clip`}>
      <rect width="1024" height="1024" rx="230"></rect>
    </clipPath>
  </defs>
  <g clip-path={`url(#${id}-clip)`}>
    <rect width="1024" height="1024" fill={`url(#${id}-bg)`}></rect>
    <g transform="translate(277 398) scale(1.15)">
