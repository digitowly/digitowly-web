---
/**
 * A strip of pixel pine trees in `currentColor`, with a lighter row behind.
 * Sits at the bottom of a section and leads into the next one.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const VW = 400;
const VH = 22;

function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** Returns one rect per horizontal run of filled pixels. */
function forest(seed: number, minH: number, maxH: number, gap: number) {
  const rnd = rng(seed);
  const trees: { cx: number; top: number }[] = [];
  for (let x = 2; x < VW; x += gap + Math.floor(rnd() * gap)) {
    trees.push({ cx: x, top: VH - minH - Math.floor(rnd() * (maxH - minH)) });
  }
  const filled = (x: number, y: number) => {
    if (y >= VH - 2) return true;
    return trees.some(({ cx, top }) => {
      const dy = y - top;
      if (dy < 0) return false;
      const tier = Math.floor(dy / 4);
      const within = dy % 4;
      const hw = Math.floor(tier * 1.1 + within * 0.7);
      return Math.abs(x - cx) <= hw;
    });
  };
  const rects: { x: number; y: number; w: number }[] = [];
  for (let y = 0; y < VH; y++) {
    let x = 0;
    while (x < VW) {
      if (!filled(x, y)) {
        x++;
        continue;
      }
      let end = x;
      while (end < VW && filled(end, y)) end++;
      rects.push({ x, y, w: end - x });
      x = end;
    }
  }
  return rects;
}

const back = forest(4, 10, 21, 7);
const front = forest(9, 5, 15, 9);
---

<svg
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${VW} ${VH}`}
  preserveAspectRatio="xMidYMax slice"
  shape-rendering="crispEdges"
  class:list={["block w-full fill-current", className]}
>
  <g opacity="0.45">
    {back.map((r) => (
      <rect x={r.x} y={r.y} width={r.w} height="1" />
    ))}
  </g>
  {front.map((r) => (
    <rect x={r.x} y={r.y} width={r.w} height="1" />
  ))}
</svg>
