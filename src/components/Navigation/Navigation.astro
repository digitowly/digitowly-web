---
import Logo from "../Logo/Logo.astro";

interface Props {
  tone: "paper" | "mint" | "forest";
}

const { tone } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");

const links = [
  { href: "/skauz", label: "Skauz" },
  { href: "/rhymate", label: "Rhymate" },
  { href: "/#contact", label: "Contact" },
];
---

<header
  id="site-nav"
  data-tone={tone}
  class="gutter fixed inset-x-0 top-0 z-50 flex h-20 items-center justify-between text-ink transition-[background-color,box-shadow] duration-500 data-[scrolled]:shadow-[0_1px_0_rgb(22_26_29/0.08)] data-[tone=forest]:text-cream data-[tone=mint]:bg-mint/0 data-[tone=paper]:bg-paper/0 data-[tone=forest]:bg-forest/0 data-[scrolled]:data-[tone=mint]:bg-mint/85 data-[scrolled]:data-[tone=paper]:bg-paper/85 data-[scrolled]:data-[tone=forest]:bg-forest/85 data-[scrolled]:backdrop-blur-lg"
>
  <a href="/" aria-label="digitowly home">
    <Logo />
  </a>
  <nav aria-label="Main">
    <ul class="flex items-center gap-6 text-[0.95rem] font-medium sm:gap-10">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={path === href ? "page" : undefined}
            class="relative py-2 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-500 after:ease-calm hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const nav = document.getElementById("site-nav");
  const update = () =>
    nav?.toggleAttribute("data-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", update, { passive: true });
  update();
</script>
