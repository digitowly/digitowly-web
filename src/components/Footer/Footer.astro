---
const currentYear = new Date().getFullYear();
---

<footer class="gutter bg-ink py-10 text-paper/60">
  <div class="flex flex-col gap-6 text-sm sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {currentYear}&nbsp;<span class="text-paper">digitowly</span> · Made with
      care (and coffee)
    </p>
    <ul class="flex flex-wrap items-center gap-x-8 gap-y-3">
      <li>
        <a href="/skauz" class="transition-colors hover:text-paper">
          Skauz
        </a>
      </li>
      <li>
        <a href="/rhymate" class="transition-colors hover:text-paper">
          Rhymate
        </a>
      </li>
      <li>
        <a
          href="https://github.com/digitowly"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-paper"
        >
          GitHub
        </a>
      </li>
      <li>
        <a href="/privacy" class="transition-colors hover:text-paper">
          Privacy
        </a>
      </li>
      <li>
        <a href="/impressum" class="transition-colors hover:text-paper">
          Impressum
        </a>
      </li>
    </ul>
  </div>
</footer>
