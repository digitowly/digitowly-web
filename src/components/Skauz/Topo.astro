---
/**
 * Decorative topographic contour lines with a few sighting pins.
 * Paths are generated deterministically so every build looks the same.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const cx = 300;
const cy = 300;
const rings = Array.from({ length: 9 }, (_, i) => {
  const base = 34 + i * 30;
  const steps = 72;
  const pts = Array.from({ length: steps }, (_, k) => {
    const t = (k / steps) * Math.PI * 2;
    const wobble =
      Math.sin(t * 3 + i * 0.7) * (6 + i * 1.6) +
      Math.sin(t * 5 - i * 0.4) * (3 + i * 0.8) +
      Math.cos(t * 2 + i) * (4 + i);
    const r = base + wobble;
    return [cx + Math.cos(t) * r * 1.08, cy + Math.sin(t) * r * 0.92];
  });
  return (
    "M" + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join("L") + "Z"
  );
});

const pins = [
  [214, 196],
  [402, 248],
  [268, 418],
  [452, 430],
  [138, 352],
];
---

<svg
  class={className}
  viewBox="0 0 600 600"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <g stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
    {rings.map((d, i) => (
      <path d={d} opacity={0.55 - i * 0.045} />
    ))}
  </g>
  {pins.map(([x, y]) => (
    <g>
      <circle cx={x} cy={y} r="14" class="fill-amber/20" />
      <circle cx={x} cy={y} r="5" class="fill-amber" />
    </g>
  ))}
</svg>
