---
interface Props {
  no: string;
  title: string;
}

const { no, title } = Astro.props;
---

<section class="grid gap-4 border-t border-ink/15 py-10 sm:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
  <header class="lg:sticky lg:top-28 lg:self-start">
    <span class="serif-accent text-2xl text-moss">{no}</span>
    <h3 class="display mt-2 text-3xl text-balance sm:text-4xl">{title}</h3>
  </header>
  <div class="max-w-2xl space-y-4 text-[1.0625rem] leading-relaxed text-ink/80 [&_a]:break-words [&_a]:text-ink [&_a]:underline [&_a]:decoration-ink/30 [&_a]:underline-offset-4 hover:[&_a]:decoration-ink [&_li]:pl-1 [&_strong]:font-semibold [&_strong]:text-ink [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5">
    <slot />
  </div>
</section>
