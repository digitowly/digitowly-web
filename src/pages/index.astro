---
import Layout from "../layouts/Layout.astro";
import RhymateIcon from "../components/Rhymate/RhymateIcon.astro";
import PhoneFrame from "../components/Rhymate/PhoneFrame.astro";
import editor from "../assets/rhymate/editor.png";
import { Image } from "astro:assets";
import Topo from "../components/Skauz/Topo.astro";
import owl from "../assets/skauz/owl.png";
import ForestScene from "../components/Forest/ForestScene.astro";
import Fireflies from "../components/Forest/Fireflies.astro";
import PixelEdge from "../components/Forest/PixelEdge.astro";
import PixelArt from "../components/Forest/PixelArt.astro";
import PixelTreeline from "../components/Forest/PixelTreeline.astro";
import {
  mailOwlUp,
  mailOwlDown,
  mailOwlPalette,
  mushrooms,
  mushroomPalette,
  fern,
  leaf,
} from "../components/Forest/sprites";

const services = [
  {
    title: "Websites",
    body: "Fast, responsive and accessible websites that feel at home on phones, tablets and desktops alike.",
  },
  {
    title: "Apps",
    body: "Native mobile apps and PWAs that are a joy to use — smooth, clean and dependable everywhere.",
  },
];

const values = [
  { word: "Care", note: "Every detail considered, nothing rushed." },
  { word: "Proven tech", note: "Solid foundations that last." },
  { word: "User focus", note: "Built for the people who use it." },
  {
    word: "Privacy",
    note: "No trackers. We don’t even know you’re here.",
    href: "/privacy",
  },
];

/**
 * Falling leaves scattered over the values section. They only sit in empty
 * space: the top and bottom padding everywhere, and on wider screens also
 * the gap between each word and its note. `wide` leaves are hidden on phones,
 * where the text stacks into one column.
 */
const fallen = [
  {
    pos: "top-[3%] right-[12%]",
    size: "w-8",
    tint: "#c95a2e",
    flip: false,
    wide: false,
  },
  {
    pos: "top-[31%] left-[40%]",
    size: "w-6",
    tint: "#ffa800",
    flip: true,
    wide: true,
  },
  {
    pos: "top-[57%] left-[34%]",
    size: "w-5",
    tint: "#ba8c52",
    flip: false,
    wide: true,
  },
  {
    pos: "top-[17%] left-[50%]",
    size: "w-5",
    tint: "#e8843a",
    flip: true,
    wide: true,
  },
  {
    pos: "bottom-[3%] right-[24%]",
    size: "w-7",
    tint: "#9c3f24",
    flip: false,
    wide: false,
  },
];
---

<Layout title="digitowly — for digital places" tone="forest">
  <!-- Hero -->
  <section class="relative flex min-h-svh flex-col justify-end overflow-hidden bg-forest text-cream">
    <ForestScene class="absolute inset-0" />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-forest from-5% via-forest/55 via-40% to-forest/0 to-70%"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-linear-to-b from-forest/70 to-forest/0"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-forest/45 to-forest/0 to-60% lg:block"
    ></div>

    <div class="gutter relative pt-32 pb-14 sm:pb-20">
      <p
        class="pixel rise mb-6 inline-flex items-center gap-3 text-xs text-cream/75 sm:text-sm"
        style="animation-delay: 40ms"
      >
        <span class="size-2 bg-amber shadow-[0_0_0_3px_rgb(255_168_0/0.25)]"></span>
        A small studio in the woods
      </p>
      <h1 class="text-giant [text-shadow:0_2px_30px_rgb(16_36_30/0.45)]">
        <span
          class="serif-accent rise block text-[0.42em] leading-none text-cream/85"
          style="animation-delay: 80ms"
        >
          for
        </span>
        <span class="display rise block" style="animation-delay: 200ms">
          digital
        </span>
        <span class="display rise block" style="animation-delay: 320ms">
          places<span class="text-owl">.</span>
        </span>
      </h1>

      <div
        class="rise mt-12 flex flex-col gap-6 border-t border-cream/20 pt-6 text-lg sm:flex-row sm:items-end sm:justify-between"
        style="animation-delay: 480ms"
      >
        <p class="max-w-md text-cream/80">
          A small, independent studio. Built with care, proven tech and user
          focus.
        </p>
        <a
          href="#contact"
          class="group inline-flex items-center gap-3 font-medium text-cream"
        >
          Start a conversation
          <span
            aria-hidden="true"
            class="inline-block transition-transform duration-500 ease-calm group-hover:translate-x-1.5"
          >
            →
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Skauz: main project -->
  <section class="relative overflow-hidden bg-forest text-cream">
    <Fireflies count={16} seed={3} />
    <Topo class="pointer-events-none absolute -right-[40%] -bottom-[15%] w-[140%] text-canopy sm:-right-[25%] sm:w-[90%] lg:-top-[10%] lg:-right-[10%] lg:bottom-auto lg:w-[60%]" />
    <div class="gutter relative grid items-center gap-14 py-24 sm:py-36 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="pixel inline-flex items-center gap-3 border-2 border-amber/50 px-4 py-2 text-xs text-amber sm:text-sm">
          <span class="size-2 bg-amber"></span>
          Our main project · work in progress
        </p>
        <h2 class="display mt-10 text-giant">Skauz</h2>
        <p class="serif-accent mt-4 text-big text-amber">
          for everyone who stops to look.
        </p>
        <p class="mt-8 max-w-lg text-lg leading-relaxed text-cream/80">
          A map of the wildlife around you. Find out what’s been spotted nearby,
          look up species and log your own sightings. Private by default,
          because some owls prefer not to be famous.
        </p>
        <a
          href="/skauz"
          class="group mt-10 inline-flex items-center gap-3 rounded-full bg-amber px-7 py-4 font-medium text-forest transition-colors duration-500 hover:bg-cream"
        >
          Meet Skauz
          <span
            aria-hidden="true"
            class="transition-transform duration-500 ease-calm group-hover:translate-x-1"
          >
            →
          </span>
        </a>
      </div>
      <div class="flex justify-center lg:justify-end">
        <Image
          src={owl}
          alt="The Skauz owl: a forest-green owl with amber eyes in front of pine trees"
          widths={[240, 400, 640]}
          sizes="(min-width: 1024px) 24rem, 60vw"
          class="w-56 drop-shadow-[0_30px_40px_rgb(0_0_0/0.35)] sm:w-72 lg:w-96"
        />
      </div>
    </div>
  </section>

  <PixelEdge
    variant="canopy"
    bg="#f3efe6"
    fg="#10241e"
    accent="#2c4639"
    class="h-28 sm:h-40"
  />

  <!-- Apps -->
  <section id="projects" class="gutter scroll-mt-20 bg-paper py-24 sm:py-32">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="display text-big">
        Out now{" "}
        <span class="serif-accent tracking-normal text-moss">
          on the App Store.
        </span>
      </h2>
      <p class="text-ink/60 sm:text-right">
        Apps we built because we wanted them to exist.
      </p>
    </div>

    <ul class="mt-12 grid gap-6">
      <li>
        <a
          href="/rhymate"
          class="group grid overflow-hidden rounded-[2rem] bg-mint text-pine transition-colors duration-500 hover:bg-[#b5edd4] md:grid-cols-[1.4fr_1fr]"
        >
          <div class="p-7 sm:p-10 lg:p-14">
            <RhymateIcon size={56} class="rounded-[22%] shadow-sm" />
            <h3 class="display mt-8 text-4xl sm:text-5xl">Rhymate</h3>
            <p class="serif-accent mt-2 text-2xl text-teal sm:text-3xl">
              for when the second verse won’t come.
            </p>
            <p class="mt-6 max-w-md leading-relaxed text-pine/80">
              A songwriting app for lyrics, chords and finding a rhyme at 2am.
              It opens right where you left off. On iPhone, iPad and Mac.
            </p>
            <span class="mt-8 inline-flex items-center gap-2 font-medium">
              Take a look
              <span
                aria-hidden="true"
                class="transition-transform duration-500 ease-calm group-hover:translate-x-1"
              >
                →
              </span>
            </span>
          </div>
          <div class="relative h-64 overflow-hidden sm:h-80 md:h-auto">
            <PhoneFrame
              src={editor}
              alt="Rhymate's editor showing the song Open Road with chords above the lyrics"
              class="absolute top-8 left-1/2 w-52 -translate-x-1/2 rotate-[4deg] transition-transform duration-700 ease-calm group-hover:-translate-y-2 sm:w-60 md:top-14"
            />
          </div>
        </a>
      </li>
    </ul>
  </section>

  <PixelEdge
    variant="meadow"
    bg="#f3efe6"
    fg="#c9d5c1"
    accent="#7f9a78"
    class="h-16 sm:h-24"
  />

  <!-- What we build -->
  <section class="gutter relative overflow-hidden bg-sage py-24 sm:py-36">
    <PixelArt
      rows={fern}
      palette={{ g: "#2c4639" }}
      class="pointer-events-none absolute top-16 right-[8%] w-16 opacity-30 sm:w-24"
    />
    <PixelArt
      rows={mushrooms}
      palette={mushroomPalette}
      class="pointer-events-none absolute right-5 bottom-0 w-24 sm:right-10 sm:w-36 lg:right-16"
    />
    <p class="pixel mb-10 text-sm text-moss">We build &amp; value</p>
    <ul class="grid gap-16 md:grid-cols-2 md:gap-10">
      {services.map(({ title, body }) => (
        <li class="border-t border-moss/25 pt-6">
          <h2 class="display text-huge text-moss">{title}</h2>
          <p class="mt-6 max-w-sm text-lg leading-relaxed text-moss/80">
            {body}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <PixelEdge variant="ground" bg="#e9dcc5" fg="#c9d5c1" class="h-20 sm:h-28" />

  <!-- Values -->
  <section class="gutter relative overflow-hidden bg-sand pt-24 pb-16 sm:pt-36 sm:pb-24">
    {fallen.map(({ pos, size, tint, flip, wide }) => (
      <PixelArt
        rows={leaf}
        palette={{ l: tint, L: "#4a321c" }}
        class:list={[
          "pointer-events-none absolute opacity-70",
          pos,
          size,
          flip && "-scale-x-100",
          wide && "hidden sm:block",
        ]}
      />
    ))}
    <h2 class="sr-only">What we value</h2>
    <ul class="relative flex flex-col">
      {values.map(({ word, note, href }) => (
        <li class="flex flex-col gap-3 border-t border-ink/15 py-8 sm:flex-row sm:items-baseline sm:justify-between">
          {href ? (
            <a
              href={href}
              class="group display inline-flex items-baseline gap-3 text-big"
            >
              {word}
              <span
                aria-hidden="true"
                class="text-[0.5em] transition-transform duration-500 ease-calm group-hover:translate-x-1.5"
              >
                →
              </span>
            </a>
          ) : (
            <span class="display text-big">{word}</span>
          )}
          <span class="serif-accent text-2xl text-ink/70 sm:text-3xl">
            {note}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <div class="bg-sand">
    <PixelTreeline class="h-20 text-moss sm:h-28" />
  </div>

  <!-- Contact -->
  <section
    id="contact"
    class="gutter relative scroll-mt-20 overflow-hidden bg-moss pt-20 pb-28 text-paper sm:pt-28 sm:pb-40"
  >
    <Fireflies count={10} seed={8} class="opacity-80" />
    <p class="pixel relative text-sm text-sage">Contact</p>
    <div class="relative mt-8 flex items-end justify-between gap-6">
      <h2 class="display text-giant">
        Let’s <span class="serif-accent tracking-normal text-sage">talk</span>.
      </h2>
      <div class="mail-owl relative mb-[0.2em] w-24 shrink-0 sm:w-40 lg:w-56">
        <PixelArt
          rows={mailOwlUp}
          palette={mailOwlPalette}
          title="The digitowly owl flying in with a letter"
          class="flap-up block w-full"
        />
        <PixelArt
          rows={mailOwlDown}
          palette={mailOwlPalette}
          class="flap-down absolute inset-0 w-full"
        />
      </div>
    </div>
    <div class="relative mt-14 flex flex-col gap-4 border-t border-paper/20 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md text-lg text-paper/75">
        Have a project, an idea or just a question? Drop us a line.
      </p>
      <a
        href="mailto:info@digitowly.com"
        class="display text-3xl tracking-tight underline decoration-sage/50 decoration-1 underline-offset-8 transition-colors duration-500 hover:decoration-sage sm:text-4xl"
      >
        info@digitowly.com
      </a>
    </div>
  </section>
  <PixelEdge variant="hills" bg="#2c4639" fg="#161a1d" class="h-16 sm:h-24" />
</Layout>
