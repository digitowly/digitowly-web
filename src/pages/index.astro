---
import Layout from "../layouts/Layout.astro";
import RhymateIcon from "../components/Rhymate/RhymateIcon.astro";
import PhoneFrame from "../components/Rhymate/PhoneFrame.astro";
import editor from "../assets/rhymate/editor.png";

const services = [
  {
    no: "01",
    title: "Websites",
    body: "Fast, responsive and accessible websites that feel at home on phones, tablets and desktops alike.",
  },
  {
    no: "02",
    title: "Apps",
    body: "Native mobile apps and PWAs that are a joy to use — smooth, clean and dependable everywhere.",
  },
];

const values = [
  { word: "Care", note: "Every detail considered, nothing rushed." },
  { word: "Proven tech", note: "Solid foundations that last." },
  { word: "User focus", note: "Built for the people who use it." },
  {
    word: "Privacy",
    note: "No trackers. We don’t even know you’re here.",
    href: "/privacy",
  },
];
---

<Layout title="digitowly — for digital places">
  <!-- Hero -->
  <section class="gutter relative flex min-h-svh flex-col justify-end overflow-hidden bg-paper pt-32 pb-14 sm:pb-20">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-[20vw] -right-[25vw] size-[70vw] rounded-full bg-sage/60 blur-3xl"
    ></div>

    <h1 class="relative text-giant">
      <span
        class="serif-accent rise block text-[0.42em] leading-none text-moss"
        style="animation-delay: 80ms"
      >
        for
      </span>
      <span class="display rise block" style="animation-delay: 200ms">
        digital
      </span>
      <span class="display rise block" style="animation-delay: 320ms">
        places<span class="text-owl">.</span>
      </span>
    </h1>

    <div
      class="rise relative mt-12 flex flex-col gap-6 border-t border-ink/15 pt-6 text-lg sm:flex-row sm:items-end sm:justify-between"
      style="animation-delay: 480ms"
    >
      <p class="max-w-md text-ink/75">
        A small, independent studio from Cologne. Built with care, proven tech
        and user focus.
      </p>
      <a
        href="#contact"
        class="group inline-flex items-center gap-3 font-medium text-ink"
      >
        Start a conversation
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-500 ease-calm group-hover:translate-x-1.5"
        >
          →
        </span>
      </a>
    </div>
  </section>

  <!-- What we build -->
  <section class="gutter bg-sage py-24 sm:py-36">
    <p class="mb-10 text-sm font-medium tracking-[0.2em] text-moss uppercase">
      We build &amp; value
    </p>
    <ul class="grid gap-16 md:grid-cols-2 md:gap-10">
      {services.map(({ no, title, body }) => (
        <li class="border-t border-moss/25 pt-6">
          <span class="serif-accent text-2xl text-moss">{no}</span>
          <h2 class="display mt-4 text-huge text-moss">{title}</h2>
          <p class="mt-6 max-w-sm text-lg leading-relaxed text-moss/80">
            {body}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Rhymate teaser -->
  <section class="bg-mint text-pine">
    <div class="gutter grid items-center gap-16 py-24 sm:py-32 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <div class="flex items-center gap-4">
          <RhymateIcon size={64} class="rounded-[22%] shadow-sm" />
          <p class="text-sm font-medium tracking-[0.2em] uppercase">
            Our own app
          </p>
        </div>
        <h2 class="display mt-10 text-huge">
          Rhymate
          <span class="serif-accent block text-[0.55em] tracking-normal">
            find the word, keep the flow.
          </span>
        </h2>
        <p class="mt-8 max-w-lg text-lg leading-relaxed text-pine/80">
          A quiet writing companion for songwriters and lyricists. Rhymes,
          synonyms and definitions, right where your lyrics live — on iPhone,
          iPad and Mac.
        </p>
        <a
          href="/rhymate"
          class="group mt-10 inline-flex items-center gap-3 rounded-full bg-pine px-7 py-4 font-medium text-mint transition-colors duration-500 hover:bg-teal"
        >
          Discover Rhymate
          <span
            aria-hidden="true"
            class="transition-transform duration-500 ease-calm group-hover:translate-x-1"
          >
            →
          </span>
        </a>
      </div>
      <div class="flex justify-center lg:justify-end">
        <PhoneFrame
          src={editor}
          alt="Rhymate's lyric editor showing a song titled Summer Rain"
          class="w-60 rotate-[3deg] sm:w-72 lg:mr-8"
        />
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="gutter bg-sand py-24 sm:py-36">
    <h2 class="sr-only">What we value</h2>
    <ul class="flex flex-col">
      {values.map(({ word, note, href }) => (
        <li class="flex flex-col gap-3 border-t border-ink/15 py-8 sm:flex-row sm:items-baseline sm:justify-between">
          {href ? (
            <a
              href={href}
              class="group display inline-flex items-baseline gap-3 text-big"
            >
              {word}
              <span
                aria-hidden="true"
                class="text-[0.5em] transition-transform duration-500 ease-calm group-hover:translate-x-1.5"
              >
                →
              </span>
            </a>
          ) : (
            <span class="display text-big">{word}</span>
          )}
          <span class="serif-accent text-2xl text-ink/70 sm:text-3xl">
            {note}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Contact -->
  <section
    id="contact"
    class="gutter scroll-mt-20 bg-moss py-28 text-paper sm:py-40"
  >
    <p class="text-sm font-medium tracking-[0.2em] text-sage uppercase">
      Contact
    </p>
    <h2 class="display mt-8 text-giant">
      Let’s <span class="serif-accent tracking-normal text-sage">talk</span>.
    </h2>
    <div class="mt-14 flex flex-col gap-4 border-t border-paper/20 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md text-lg text-paper/75">
        Have a project, an idea or just a question? Drop us a line.
      </p>
      <a
        href="mailto:info@digitowly.com"
        class="display text-3xl tracking-tight underline decoration-sage/50 decoration-1 underline-offset-8 transition-colors duration-500 hover:decoration-sage sm:text-4xl"
      >
        info@digitowly.com
      </a>
    </div>
  </section>
</Layout>
